{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "fishing-with-friends-bunshin",
          "appId": "1:404136368123:android:455784fbf9e5dd1ce91d5e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "fishing-with-friends-bunshin",
          "configurations": {
            "android": "1:404136368123:android:455784fbf9e5dd1ce91d5e",
            "ios": "1:404136368123:ios:8c49f11651928d38e91d5e"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.env",
      "**/.env.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|png|jpg|jpeg|svg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
