# Copy this file to `.confluence/credentials` and fill in real values.
# `.confluence/credentials` is gitignored.

# Your Confluence Cloud base URL (no trailing slash)
# Example: https://yourorg.atlassian.net/wiki
CONFLUENCE_BASE_URL=

# The email you log into Atlassian with
CONFLUENCE_EMAIL=

# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# Optional. If set, docs land under this page id.
# CONFLUENCE_PARENT_ID=

# Optional. If set (and PARENT_ID is not), docs land under the page with
# this exact title.
# CONFLUENCE_PARENT_TITLE=

# Optional. Defaults to MFS.
# CONFLUENCE_SPACE=
